#!/bin/sh
# Auto-fix habs-react-kit dependency after merge

BRANCH=$(git rev-parse --abbrev-ref HEAD)

case "$BRANCH" in
  prod)
    REF="prod"
    ;;
  stage)
    REF="stage"
    ;;
  dev)
    REF="dev"
    ;;
  *)
    # For other branches, don't auto-fix
    exit 0
    ;;
esac

CURRENT_REF=$(node -p "require('./package.json').dependencies['habs-react-kit']" 2>/dev/null)
EXPECTED_REF="github:HABS-BRAIN/react-kit#$REF"

if [ "$CURRENT_REF" != "$EXPECTED_REF" ]; then
  echo "🔧 Auto-fixing habs-react-kit dependency for branch '$BRANCH'"
  
  # Update package.json
  node -e "
    const fs = require('fs');
    const pkg = require('./package.json');
    pkg.dependencies['habs-react-kit'] = '$EXPECTED_REF';
    fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n');
  "
  
  # Run pnpm install to update lock file
  pnpm install
  
  echo "✅ Updated habs-react-kit to $EXPECTED_REF"
  echo "⚠️  Remember to commit these changes: git add package.json pnpm-lock.yaml && git commit -m 'chore: update habs-react-kit ref for $BRANCH'"
fi
