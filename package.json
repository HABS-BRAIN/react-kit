{
  "name": "habs-react-kit",
  "version": "1.0.1",
  "description": "",
  "author": "Bogdan Gorelkin <b.gorelkin@yandex.com>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "npm-scripts.mjs",
    "lib",
    "resources",
    "package-branch-validation"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "prepare": "node npm-scripts.mjs prepare",
    "typescript:build": "node npm-scripts.mjs typescript:build",
    "typescript:watch": "node npm-scripts.mjs typescript:watch",
    "lint": "node npm-scripts.mjs lint",
    "test": "node npm-scripts.mjs test",
    "dev": "clear && ts-node ./debug.ts",
    "coverage": "node npm-scripts.mjs coverage",
    "install-deps": "node npm-scripts.mjs install-deps",
    "release:check": "node npm-scripts.mjs release:check",
    "release:dev": "node npm-scripts.mjs release:dev",
    "release": "node npm-scripts.mjs release"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "node",
    "testRegex": "src/tests/test.*\\.ts",
    "transform": {
      "^.*\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              "TS151001"
            ]
          }
        }
      ]
    },
    "cacheDirectory": ".cache/jest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "rc-select": "^14.16.8",
    "react": "^19.2.4",
    "react-dom": "19.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "antd": "^5.29.3",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "socket.io": "^4.8.3"
  }
}
